# 前端 production build → Caddy 靜態檔（docker-compose.prod.yml 的 caddy 服務）
FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm exec ng build --configuration production --output-path /out \
 && rm -rf /out/browser/campaigns   # 戰役不上第一版：不帶戰役 JSON

FROM caddy:2.10-alpine
COPY --from=build /out/browser /srv/web
