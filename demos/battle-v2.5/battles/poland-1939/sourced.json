   "seq": 1,
   "key": "poland_1939_p1",
   "name_zh": "進攻與突破",
   "from": "1939-09-01",
   "to": "1939-09-06",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s1",
     "quote": "1 Sep — Wehrmacht crosses Polish frontier"
    },
    {
     "src": "s2",
     "quote": "Chapter 6. Attack and Breakthrough ... Army Group South, 1-6 September"
    }
   ],
   "summary_zh": "德軍9月1日越境，北方集團軍群3日切斷波蘭走廊，南方集團軍群渡過瓦爾塔河並攻佔琴斯托霍瓦。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s1",
     "quote": "3 Sep — Army Group North cuts the Corridor and Army Group South crosses the Wartha."
    },
    {
     "src": "s3",
     "quote": "Czestochowa was taken on the morning of 3 September"
    }
   ],
   "lines_note": "Kennedy 未給出本階段具體戰線走向，待查證"
  },
  {
   "seq": 2,
   "key": "poland_1939_p2",
   "name_zh": "殲滅波軍主力（布祖拉／拉多姆）",
   "from": "1939-09-07",
   "to": "1939-09-16",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s2",
     "quote": "7. The Destruction of the Polish Army ... Army Group South, 7-17 September"
    }
   ],
   "summary_zh": "德軍於拉多姆殲滅波軍一部，並將西部波軍殘部圍困於庫特諾與華沙之間，北翼第19軍渡納雷夫河直趨布列斯特。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s1",
     "quote": "11 Sep — Major Polish force destroyed at Radom."
    },
    {
     "src": "s3",
     "quote": "The remnants of the Polish armies in the west were all but encircled about Kutno and in the area between that city and Warsaw."
    }
   ]
  },
  {
   "seq": 3,
   "key": "poland_1939_p3",
   "name_zh": "蘇聯入侵與華沙投降",
   "from": "1939-09-17",
   "to": "1939-09-27",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s1",
     "quote": "17 Sep — Red Army moves into eastern Poland."
    },
    {
     "src": "s1",
     "quote": "27 Sep — Surrender of Warsaw."
    }
   ],
   "summary_zh": "9月17日紅軍進入波蘭東部，德軍止步於布格河—布列斯特—比亞韋斯托克一線並於22日將布列斯特移交紅軍，華沙於27日投降。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s3",
     "quote": "directed to remain west of the line along the Bug River-Brzesc-Bialystok."
    },
    {
     "src": "s3",
     "quote": "The XIX Corps turned Brzesc over to the Red Army on 22 September"
    }
   ]
  },
  {
   "seq": 4,
   "key": "poland_1939_p4",
   "name_zh": "最後抵抗：莫德林、海爾、科克",
   "from": "1939-09-28",
   "to": "1939-10-06",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s1",
     "quote": "29 Sep — Surrender of Modlin."
    },
    {
     "src": "s3",
     "quote": "the Kock force surrendered on 6 October"
    }
   ],
   "summary_zh": "莫德林於9月29日投降，海爾半島守軍10月1日請求談判，波軍最後一支主力於10月4至6日在科克作戰後投降。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s3",
     "quote": "An armistice was arranged at 0730 on 28 September and the formal surrender to Third Army's II Corps took place the following day."
    },
    {
     "src": "s3",
     "quote": "On 1 October Rear Admiral J. Unrug, commander at Hela, requested a surrender parley."
    },
    {
     "src": "s3",
     "quote": "The last organized stand by the Polish Army was made at Kock, where heavy fighting raged from 4 to 6 October."
    }
   ],
   "lines_note": "10月1日分界線再度變更（Kennedy p.118 文字被圖版截斷），新線走向待查證"
  }
 ],
