      },
      {
       "sourceKey": "pilsudski-biogram",
       "locator": "biogram, para 1",
       "quote": "In February 1908, at a meeting of the Polish Socialist Party in Lwow",
       "quoteLang": "en",
       "evidenceNote": null,
       "accessedOn": "2026-11-18",
       "grade": "B",
       "datePrecision": "month",
       "claimSpan": null,
       "policyVersion": "bio-2026-11-v0"
      },
      {
       "sourceKey": "pilsudski-biogram",
       "locator": "biogram, para 1",
       "quote": "From that day they became collaborators and friends.",
       "quoteLang": "en",
       "evidenceNote": null,
       "accessedOn": "2026-11-18",
       "grade": "B",
       "datePrecision": null,
       "claimSpan": null,
