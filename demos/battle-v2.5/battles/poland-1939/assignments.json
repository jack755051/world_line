 "engagements": {
  "e-westerplatte": {
   "importance": 2,
   "summary_zh": "但澤港外的波軍倉庫守了七天，戰爭的第一聲砲響。"
  },
  "e-mokra": {
   "importance": 2,
   "summary_zh": "沃倫騎兵旅擋下德軍裝甲部隊一天。"
  },
  "e-mlawa": {
   "importance": 2,
   "summary_zh": "莫德林軍團在邊境工事擋住自東普魯士南下的德軍，側翼被突破後撤往華沙、莫德林。"
  },
  "e-tuchola": {
   "importance": 2,
   "summary_zh": "德軍橫切波蘭走廊，波莫瑞軍團一部被壓在維斯瓦河邊。"
  },
  "e-wizna": {
   "importance": 2,
   "summary_zh": "納雷夫河畔的碉堡群擋住古德林的軍數日。"
  },
  "e-warsaw": {
   "importance": 3,
   "summary_zh": "9/8 德軍裝甲部隊抵達市郊被擊退；9/15 合圍，9/28 投降。"
  },
  "e-bzura": {
   "importance": 3,
   "summary_zh": "波茲南、波莫瑞兩個軍團向南反擊德軍側翼，是整場戰役最大的一仗；最後被合圍。"
  },
  "e-lwow": {
   "importance": 2,
   "summary_zh": "德軍先到、蘇軍後到；9/22 向蘇軍投降。"
  },
  "e-modlin": {
   "importance": 2,
   "summary_zh": "羅茲軍團餘部守要塞到 9/29。"
  },
  "e-brest": {
   "importance": 2,
   "summary_zh": "古德林的軍攻下要塞，數日後移交蘇軍。"
  },
  "e-tomaszow": {
   "importance": 2,
   "summary_zh": "克拉科夫、盧布林兩軍團想突圍往東南，失敗後投降；北方集群接著再試一次。"
  },
  "e-wilno": {
   "importance": 1,
   "summary_zh": "蘇軍兩天內攻下維爾諾。"
  },
  "e-grodno": {
   "importance": 1,
   "summary_zh": "守軍與居民抵抗蘇軍數日。"
  },
  "e-hel": {
   "importance": 1,
   "summary_zh": "海岸最後的據點，守到 10/2。"
  },
  "e-szack": {
   "importance": 1,
   "summary_zh": "邊防軍在撤退途中擊退蘇軍一部。"
  },
  "e-kock": {
   "importance": 3,
   "summary_zh": "波列西耶獨立作戰群打到彈藥用盡，10/6 投降——九月戰役結束。"
  }
 }
}
