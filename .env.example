# 複製為 .env 後填值；.env 不進版控
POSTGRES_USER=worldline
POSTGRES_PASSWORD=change-me
WW2_POSTGRES_DB=appdb_ww2
WW2_DB_PORT=5432
WW2_API_PORT=5051
# 寫入端點（POST）用的 X-API-Key；未設定時所有寫入一律 503
WORLDLINE_API_KEY=

# ── 正式版（docker-compose.prod.yml）──────────────────────────
# 網域（Caddy 自動 HTTPS）；本機測試填 localhost
WL_DOMAIN=
# 正式資料庫名稱（預設 worldline）
WL_PROD_DB=
# 圖磚與 overlay 檔案所在目錄（boundaries.pmtiles、overlay.pmtiles、overlay.json；預設 ./tools/tiles/out）
WL_TILES_DIR=
# pg_restore 的 dump 檔目錄（掛到 postgres 容器 /restore；預設 ./deploy/restore）
WL_RESTORE_DIR=
# 對外埠（預設 80／443；本機測試可改 8080／8443）
WL_HTTP_PORT=
WL_HTTPS_PORT=
# 可選：映像覆寫、API 調整
WL_POSTGIS_IMAGE=
WL_MARTIN_IMAGE=
WORLDLINE_MIGRATE_ON_STARTUP=
WORLDLINE_PREWARM_DATE=
WORLDLINE_CACHE_MAX_MB=
