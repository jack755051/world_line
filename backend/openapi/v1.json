{
  "openapi": "3.1.1",
  "info": {
    "title": "World Line API",
    "description": "二戰階段歷史地圖 API。讀取公開；寫入需 X-API-Key。日期一律 YYYY-MM-DD，區間為半開 [start, end)。",
    "version": "v1"
  },
  "paths": {
    "/api/v1/sources": {
      "post": {
        "tags": [
          "Sources"
        ],
        "operationId": "CreateSource",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSourceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/v1/regimes": {
      "post": {
        "tags": [
          "Regimes"
        ],
        "operationId": "CreateRegime",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRegimeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/v1/theaters": {
      "post": {
        "tags": [
          "Theaters"
        ],
        "operationId": "CreateTheater",
        "requestBody": {
