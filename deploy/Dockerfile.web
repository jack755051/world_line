# 前端 production build → nginx 靜態檔（docker-compose.prod.yml 的 web 服務）
# 建置階段跑在建置機原生平台（產物是靜態檔，與目標平台無關）；執行階段用目標平台（linux/amd64）
FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
ARG WL_COMMIT=""
ARG WL_BUILD_TIME=""
ENV WL_COMMIT=${WL_COMMIT}
ENV WL_BUILD_TIME=${WL_BUILD_TIME}
RUN node scripts/write-version.mjs
RUN pnpm exec ng build --configuration production --output-path /out \
 && rm -rf /out/browser/campaigns /out/browser/battle   # 戰役不上線：不帶戰役 JSON，也不帶新版戰役頁 /battle/（.dockerignore 已擋 public/battle，這裡再保險一次）
# 之後要讓 /battle/ 上線（通過憲法 Decision 5 最低上線標準、WL_INCLUDE_BATTLE=1）時，要另外 COPY demos/battle-v2.5 並跑 scripts/sync-battle-page.mjs，並拿掉上面的 /out/browser/battle

FROM nginx:1.27-alpine
COPY deploy/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /out/browser /usr/share/nginx/html
