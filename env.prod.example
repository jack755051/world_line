# World Line 正式環境設定
# 複製：cp env.prod.example .env.prod
# 使用：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# .env.prod 不進版控；機密（密碼、API key）只填在 .env.prod。

# ── Compose 插值：映像與標籤 ─────────────────────────────
# api：DigitalOcean Container Registry（私有）
API_IMAGE=registry.digitalocean.com/sanring/worldline-api
API_IMAGE_TAG=latest
# web（前端＋nginx）：Docker Hub（公開）
WEB_IMAGE=jackdai850817/worldline-web
WEB_IMAGE_TAG=latest

# ── Compose 插值：對外埠與檔案位置 ───────────────────────
# web 只綁 127.0.0.1:<WEB_PORT>；Cloudflare Tunnel 指到 http://127.0.0.1:<WEB_PORT>
WEB_PORT=4080
# 圖磚目錄（boundaries.pmtiles、overlay.pmtiles、overlay.json 與其版本檔）
TILES_DIR=./tiles
# pg_restore 用的 dump 檔目錄（掛到 postgres 容器 /restore）
RESTORE_DIR=./restore

# ── Postgres ─────────────────────────────────────────────
POSTGRES_DB=worldline
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── API（ASP.NET；連線字串由 compose 組成 ConnectionStrings__WorldLine）─
# 寫入端點（POST）用的 X-API-Key；未設定時所有寫入一律 503
WORLDLINE_API_KEY=
# 用 pg_restore 的資料時維持 false
WORLDLINE_MIGRATE_ON_STARTUP=false
WORLDLINE_PREWARM_DATE=
WORLDLINE_CACHE_MAX_MB=
