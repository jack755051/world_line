 "phases": [
  {
   "seq": 1,
   "key": "dunkirk_1940_p1",
   "name_zh": "發電機行動啟動與走廊作戰",
   "from": "1940-05-26",
   "to": "1940-05-27",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s1",
     "quote": "By the following Sunday evening, when Operation Dynamo was ordered ..."
    },
    {
     "src": "s1",
     "quote": "By midnight on May the 27th the King of the Belgians had accepted defeat and the Belgian Army had been ordered to cease fire."
    }
   ],
   "summary_zh": "5月26日晚下令發動發電機行動，英國遠征軍沿狹窄走廊且戰且退，法軍於27日夜放棄格拉沃利訥退守馬爾迪克—斯皮凱—貝爾格運河線，比利時軍於午夜停火。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s1",
     "quote": "During the night they withdrew from Gravelines and the Aa and occupied a line which followed canals from Mardick through Spycker to Bergues."
    }
   ]
  },
  {
   "seq": 2,
   "key": "dunkirk_1940_p2",
   "name_zh": "比軍投降後撤入灘頭陣地",
   "from": "1940-05-28",
   "to": "1940-05-29",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s14",
     "quote": "CHAPTER XIII AFTER THE BELGIAN SURRENDER 28th May, 1940"
    },
    {
     "src": "s15",
     "quote": "By midday on the 30th practically all our retiring forces were within the perimeter"
    }
   ],
   "summary_zh": "比軍投降後東翼洞開，德軍28日上午抵達紐波特一帶周界並奪得一座橋，英軍各師於29至30日陸續撤入敦克爾克周界。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s14",
     "quote": "advanced troops of the enemy reached the perimeter between Nieuport and the sea coast ... capturing and holding an undestroyed bridge and a small bridgehead in the town of Nieuport."
    }
   ]
  },
  {
   "seq": 3,
   "key": "dunkirk_1940_p3",
   "name_zh": "灘頭陣地防禦",
   "from": "1940-05-30",
   "to": "1940-05-31",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s15",
     "quote": "CHAPTER XV THE DEFENCE OF THE BRIDGEHEAD 30th May and 31st May, 1940"
    }
   ],
   "summary_zh": "英軍第1軍守西半、第2軍守東半周界，德軍31日猛攻紐波特、弗爾訥與 Bulskamp，當夜英軍放棄比利時境內東段。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s15",
     "quote": "On the 50th Division front between the frontier and Bulscamp, on the 3rd Division front near Furnes, and in the 4th Division sector at Nieuport, the enemy attacked heavily."
    },
    {
     "src": "s15",
     "quote": "During the night the eastern sector of the bridgehead was abandoned"
    }
   ]
  },
  {
   "seq": 4,
   "key": "dunkirk_1940_p4",
   "name_zh": "縮小周界與英軍最後撤離",
   "from": "1940-06-01",
   "to": "1940-06-02",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s24",
     "quote": "CHAPTER XVI LAST DAYS AT DUNKIRK 1st June to 4th June, 1940"
    },
    {
     "src": "s24",
     "quote": "when daylight put an end to the night's operations at about three o'clock there were no more British troops to be brought away."
    }
   ],
   "summary_zh": "周界縮至法國國界與貝爾格—弗爾訥運河，德軍1日主攻貝爾格與 Hoymille，英軍後衛守至1日午夜後撤往海灘，6月3日凌晨英軍撤離完畢。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s24",
     "quote": "The enemy's main attacks were at Bergues and Hoymille"
    },
    {
     "src": "s24",
     "quote": "the existing British front should be held till midnight of the 1st"
    }
   ],
   "lines_note": "國界段 Hondschoote 以東至海岸之走向依『by the French frontier to the sea』，Hondschoote 為近似頂點"
  },
  {
   "seq": 5,
   "key": "dunkirk_1940_p5",
   "name_zh": "法軍後衛與敦克爾克陷落",
   "from": "1940-06-03",
   "to": "1940-06-04",
   "dates_verified": true,
   "date_refs": [
    {
     "src": "s24",
     "quote": "In fact the remaining French troops surrendered at nine o'clock that morning, June the 4th."
    },
    {
     "src": "s24",
     "quote": "Operation Dynamo was officially ended by an Admiralty message timed 2.23 p.m."
    }
   ],
   "summary_zh": "法軍後衛掩護最後兩夜撤退，6月4日上午9時餘部投降，下午2時23分海軍部宣告發電機行動結束，共撤出338,226人。",
   "summary_verified": true,
   "summary_refs": [
    {
     "src": "s24",
     "quote": "When the operation ended 338,226 had been evacuated"
    }
   ],
   "lines_note": "6月3日法軍最後防線走向於 Ellis 未見具體描述，待查證"
  }
 ],
